<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Espace public des particuliers de La Maison d’AVA.">
  <meta name="referrer" content="no-referrer">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
  <title>Espace particuliers — Li.La by La Maison d’AVA</title>
  <style>
    :root {
      --ll-navy: #0c2241;
      --ll-navy-soft: #1a3558;
      --ll-orange: #f08247;
      --ll-cream: #faf8f4;
      --ll-white: #ffffff;
      --ll-text-secondary: #626a73;
      --ll-text-muted: #8a96a8;
      --ll-border: #e2ddd8;
      --ll-border-soft: #ede9e4;
      --ll-mauve: #a996b8;
      --ll-mauve-bg: #ede5f2;
      --ll-sage: #9aad8f;
      --ll-sage-bg: #ebf2ea;
      --ll-lilac: #6d6fa7;
      --ll-lilac-bg: #f0edf6;
      --ll-terra-bg: #fdf0ec;
      --shadow-sm: 0 1px 3px rgba(7, 30, 58, 0.06);
      --shadow-md: 0 10px 28px rgba(7, 30, 58, 0.1);
      --shadow-lg: 0 24px 64px rgba(7, 30, 58, 0.13);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      color-scheme: light;
      font-size: 16px;
      -webkit-text-size-adjust: 100%;
    }

    body {
      min-width: 320px;
      min-height: 100vh;
      color: var(--ll-navy);
      background:
        radial-gradient(circle at 7% 0%, rgba(169, 150, 184, 0.22), transparent 29rem),
        radial-gradient(circle at 100% 100%, rgba(240, 130, 71, 0.12), transparent 28rem),
        linear-gradient(180deg, #f2edf7 0%, #f7f3f3 35%, var(--ll-cream) 100%);
      font-family: "Avenir Next", Avenir, "Segoe UI", system-ui, -apple-system, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      position: fixed;
      inset: 0;
      z-index: -1;
      background-image:
        linear-gradient(rgba(12, 34, 65, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(12, 34, 65, 0.025) 1px, transparent 1px);
      background-size: 36px 36px;
      content: "";
      mask-image: linear-gradient(to bottom, black, transparent 72%);
      pointer-events: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      color: inherit;
    }

    img {
      display: block;
      max-width: 100%;
      height: auto;
    }

    [hidden] {
      display: none !important;
    }

    .page {
      width: min(1120px, calc(100% - 32px));
      min-height: 100vh;
      margin: 0 auto;
      padding: 28px 0;
    }

    .screen {
      min-height: calc(100vh - 56px);
      animation: reveal 320ms ease both;
    }

    @keyframes reveal {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    .intro-screen {
      display: grid;
      place-items: center;
    }

    .intro-card {
      position: relative;
      display: grid;
      width: 100%;
      max-width: 1030px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.85);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.83);
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(16px);
    }

    .intro-copy {
      position: relative;
      z-index: 1;
      padding: clamp(32px, 7vw, 76px);
    }

    .brand-logo {
      width: min(290px, 78%);
      margin-bottom: 38px;
    }

    .brand-fallback {
      margin-bottom: 38px;
      color: var(--ll-navy);
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.04em;
    }

    .brand-fallback span {
      color: var(--ll-orange);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 18px;
      color: var(--ll-lilac);
      font-size: 0.75rem;
      font-weight: 750;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      width: 24px;
      height: 2px;
      border-radius: 99px;
      background: var(--ll-orange);
      content: "";
    }

    h1,
    h2,
    h3 {
      font-family: "Avenir Next", Avenir, "Segoe UI", system-ui, sans-serif;
      letter-spacing: -0.035em;
    }

    h1 {
      max-width: 680px;
      font-size: clamp(2.15rem, 5.2vw, 4rem);
      line-height: 1.03;
    }

    .intro-text {
      max-width: 660px;
      margin-top: 22px;
      color: var(--ll-text-secondary);
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      line-height: 1.72;
    }

    .free-note {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 26px;
      padding: 10px 14px;
      border: 1px solid rgba(154, 173, 143, 0.55);
      border-radius: 999px;
      background: var(--ll-sage-bg);
      color: #476342;
      font-size: 0.88rem;
      font-weight: 700;
    }

    .free-note svg {
      flex: 0 0 auto;
    }

    .steps {
      display: grid;
      gap: 10px;
      margin-top: 34px;
    }

    .step {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: 12px;
      align-items: center;
      color: var(--ll-text-secondary);
      font-size: 0.9rem;
    }

    .step-number {
      display: grid;
      width: 30px;
      height: 30px;
      place-items: center;
      border-radius: 50%;
      background: var(--ll-lilac);
      color: var(--ll-white);
      font-size: 0.78rem;
      font-weight: 800;
    }

    .step strong {
      color: var(--ll-navy);
    }

    .primary-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      min-height: 56px;
      margin-top: 38px;
      padding: 15px 20px;
      border: 0;
      border-radius: 14px;
      background: var(--ll-navy);
      box-shadow: 0 12px 26px rgba(12, 34, 65, 0.2);
      color: var(--ll-white);
      cursor: pointer;
      font-weight: 750;
      transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
    }

    .primary-button:hover {
      background: var(--ll-navy-soft);
      box-shadow: 0 15px 32px rgba(12, 34, 65, 0.25);
      transform: translateY(-2px);
    }

    .primary-button:focus-visible,
    .back-button:focus-visible,
    .choice:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
      outline: 3px solid rgba(240, 130, 71, 0.5);
      outline-offset: 3px;
    }

    .intro-visual {
      position: relative;
      display: none;
      min-height: 100%;
      overflow: hidden;
      background: linear-gradient(145deg, #0c2241 0%, #29284f 60%, #463c6e 100%);
    }

    .intro-visual::before,
    .intro-visual::after {
      position: absolute;
      border-radius: 50%;
      content: "";
    }

    .intro-visual::before {
      top: -90px;
      right: -90px;
      width: 310px;
      height: 310px;
      border: 1px solid rgba(255, 255, 255, 0.17);
      box-shadow: 0 0 0 44px rgba(255, 255, 255, 0.035), 0 0 0 88px rgba(255, 255, 255, 0.025);
    }

    .intro-visual::after {
      right: 45px;
      bottom: 32px;
      width: 140px;
      height: 140px;
      background: rgba(240, 130, 71, 0.17);
      filter: blur(1px);
    }

    .brand-symbol {
      position: absolute;
      top: 50%;
      left: 50%;
      width: min(64%, 260px);
      opacity: 0.82;
      transform: translate(-50%, -50%);
      filter: drop-shadow(0 22px 30px rgba(0, 0, 0, 0.18));
    }

    .space-screen {
      padding: 8px 0 42px;
    }

    .space-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 8px 2px 28px;
    }

    .space-logo {
      width: 190px;
    }

    .back-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border: 1px solid var(--ll-border);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.72);
      color: var(--ll-text-secondary);
      cursor: pointer;
      font-size: 0.86rem;
      font-weight: 650;
    }

    .space-panel {
      padding: clamp(24px, 5vw, 52px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.86);
      box-shadow: var(--shadow-md);
      backdrop-filter: blur(14px);
    }

    .space-heading {
      max-width: 720px;
      margin-bottom: 28px;
    }

    .space-heading h2 {
      font-size: clamp(1.8rem, 4vw, 2.7rem);
      line-height: 1.1;
    }

    .space-heading p {
      margin-top: 10px;
      color: var(--ll-text-secondary);
      font-size: 0.97rem;
    }

    .choices {
      display: grid;
      gap: 12px;
    }

    .choice {
      display: grid;
      grid-template-columns: 48px 1fr 22px;
      gap: 14px;
      align-items: center;
      width: 100%;
      min-height: 84px;
      padding: 16px;
      border: 1px solid var(--ll-border-soft);
      border-radius: 16px;
      background: var(--ll-white);
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      text-align: left;
      transition: border 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    .choice:hover,
    .choice[aria-pressed="true"] {
      border-color: var(--choice-color, var(--ll-navy));
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .choice-icon {
      display: grid;
      width: 48px;
      height: 48px;
      place-items: center;
      border-radius: 14px;
      background: var(--choice-bg, var(--ll-lilac-bg));
      color: var(--choice-color, var(--ll-lilac));
    }

    .choice-label {
      font-size: 0.96rem;
      font-weight: 750;
      line-height: 1.25;
    }

    .choice-arrow {
      color: var(--ll-text-muted);
      transition: transform 180ms ease;
    }

    .choice[aria-pressed="true"] .choice-arrow {
      color: var(--choice-color, var(--ll-navy));
      transform: translateX(3px);
    }

    .choice-buy {
      --choice-bg: var(--ll-mauve-bg);
      --choice-color: var(--ll-mauve);
    }

    .choice-sell {
      --choice-bg: var(--ll-lilac-bg);
      --choice-color: var(--ll-lilac);
    }

    .choice-rent {
      --choice-bg: var(--ll-sage-bg);
      --choice-color: var(--ll-sage);
    }

    .choice-search {
      --choice-bg: var(--ll-terra-bg);
      --choice-color: var(--ll-orange);
    }

    .choice-track {
      --choice-bg: #edf1f6;
      --choice-color: var(--ll-navy-soft);
    }

    .flow-panel {
      margin-top: 22px;
      padding: clamp(20px, 4vw, 34px);
      border: 1px solid var(--ll-border);
      border-radius: 18px;
      background: var(--ll-cream);
      animation: reveal 240ms ease both;
    }

    .flow-panel h3 {
      font-size: 1.35rem;
    }

    .flow-intro {
      margin-top: 7px;
      color: var(--ll-text-secondary);
      font-size: 0.9rem;
    }

    .service-state {
      display: flex;
      gap: 11px;
      align-items: flex-start;
      margin: 18px 0 22px;
      padding: 13px 14px;
      border: 1px solid #e7cf9c;
      border-radius: 12px;
      background: #fff8e8;
      color: #715619;
      font-size: 0.84rem;
      line-height: 1.5;
    }

    .service-state svg {
      flex: 0 0 auto;
      margin-top: 1px;
    }

    .part-form {
      display: grid;
      gap: 16px;
    }

    .field-grid {
      display: grid;
      gap: 14px;
    }

    .field {
      display: grid;
      gap: 6px;
    }

    .field label {
      color: #7a6e64;
      font-size: 0.72rem;
      font-weight: 750;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      min-height: 47px;
      padding: 11px 13px;
      border: 1.5px solid #ddd6cc;
      border-radius: 10px;
      outline: none;
      background: var(--ll-white);
      color: var(--ll-navy);
    }

    .field textarea {
      min-height: 96px;
      resize: vertical;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: var(--ll-mauve);
    }

    .disabled-action {
      min-height: 50px;
      margin-top: 4px;
      padding: 13px 18px;
      border: 0;
      border-radius: 12px;
      background: #c0b8b0;
      color: var(--ll-white);
      cursor: not-allowed;
      font-weight: 750;
    }

    .local-note {
      color: var(--ll-text-muted);
      font-size: 0.77rem;
      text-align: center;
    }

    @media (min-width: 640px) {
      .page {
        width: min(1120px, calc(100% - 56px));
      }

      .field-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .field-wide {
        grid-column: 1 / -1;
      }

      .choices {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .choice-track {
        grid-column: 1 / -1;
      }
    }

    @media (min-width: 900px) {
      .intro-card {
        grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.8fr);
      }

      .intro-visual {
        display: block;
      }

      .primary-button {
        width: auto;
        min-width: 330px;
      }

      .space-panel {
        display: grid;
        grid-template-columns: minmax(300px, 0.82fr) minmax(380px, 1.18fr);
        gap: 34px;
        align-items: start;
      }

      .space-heading {
        grid-column: 1 / -1;
        margin-bottom: 2px;
      }

      .flow-panel {
        margin-top: 0;
      }
    }

    @media (max-width: 430px) {
      .page {
        width: min(100% - 24px, 1120px);
        padding: 12px 0;
      }

      .screen {
        min-height: calc(100vh - 24px);
      }

      .intro-card {
        border-radius: 20px;
      }

      .intro-copy {
        padding: 30px 22px 24px;
      }

      .brand-logo,
      .brand-fallback {
        margin-bottom: 30px;
      }

      .free-note {
        align-items: flex-start;
        border-radius: 14px;
      }

      .steps {
        margin-top: 28px;
      }

      .primary-button {
        margin-top: 30px;
      }

      .space-header {
        padding: 6px 0 18px;
      }

      .space-logo {
        width: 148px;
      }

      .back-button span {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      .space-panel {
        padding: 22px 16px;
        border-radius: 18px;
      }

      .choice {
        min-height: 76px;
        padding: 13px;
      }

      .choice-icon {
        width: 44px;
        height: 44px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="screen intro-screen" id="presentationScreen" aria-labelledby="presentationTitle">
      <div class="intro-card">
        <div class="intro-copy">
          <img class="brand-logo" src="../lila-logo-transparent.png" alt="Li.La by La Maison d’AVA" data-logo>
          <p class="brand-fallback" data-logo-fallback hidden>Li<span>·</span>La <small>by La Maison d’AVA</small></p>

          <p class="eyebrow">Espace public</p>
          <h1 id="presentationTitle">Bienvenue dans l’espace particuliers</h1>
          <p class="intro-text">Vous souhaitez acheter, vendre, louer ou confier une recherche ? Déposez votre projet en quelques minutes. La Maison d’AVA vous recontacte et mobilise les professionnels adaptés à votre besoin.</p>

          <p class="free-note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
            Le dépôt de votre demande est gratuit et sans abonnement
          </p>

          <div class="steps" aria-label="Fonctionnement en trois étapes">
            <p class="step"><span class="step-number">1</span><span><strong>Vous confiez</strong> votre projet ou votre bien</span></p>
            <p class="step"><span class="step-number">2</span><span><strong>La Maison d’AVA</strong> qualifie votre besoin</span></p>
            <p class="step"><span class="step-number">3</span><span><strong>Le collectif</strong> mobilise les professionnels adaptés</span></p>
          </div>

          <button class="primary-button" id="enterSpace" type="button">
            Accéder à mon espace particulier
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </button>
        </div>

        <div class="intro-visual" aria-hidden="true">
          <img class="brand-symbol" src="../lila-symbol-transparent.png" alt="">
        </div>
      </div>
    </section>

    <section class="screen space-screen" id="spaceScreen" aria-labelledby="spaceTitle" hidden>
      <header class="space-header">
        <img class="space-logo" src="../lila-logo-transparent.png" alt="Li.La by La Maison d’AVA" data-logo>
        <button class="back-button" id="backToPresentation" type="button">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6"/>
          </svg>
          <span>Retour à la présentation</span>
        </button>
      </header>

      <div class="space-panel">
        <div class="space-heading">
          <p class="eyebrow">Espace particulier</p>
          <h2 id="spaceTitle" tabindex="-1">Que souhaitez-vous faire ?</h2>
          <p>Sélectionnez votre projet pour afficher les informations utiles.</p>
        </div>

        <div class="choices" aria-label="Choix du projet">
          <button class="choice choice-buy" type="button" data-flow="recherche_achat" aria-pressed="false">
            <span class="choice-icon">
              <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 12 12 3l9 9M5 10v10h14V10"/>
              </svg>
            </span>
            <span class="choice-label">Je souhaite acheter</span>
            <svg class="choice-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>

          <button class="choice choice-sell" type="button" data-flow="vendre" aria-pressed="false">
            <span class="choice-icon">
              <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>
              </svg>
            </span>
            <span class="choice-label">Je souhaite vendre</span>
            <svg class="choice-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>

          <button class="choice choice-rent" type="button" data-flow="confier_location" aria-pressed="false">
            <span class="choice-icon">
              <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 7.3-7.3M15 7l2 2M18 4l2 2"/>
              </svg>
            </span>
            <span class="choice-label">Confier mon bien à la location</span>
            <svg class="choice-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>

          <button class="choice choice-search" type="button" data-flow="confier_recherche" aria-pressed="false">
            <span class="choice-icon">
              <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
              </svg>
            </span>
            <span class="choice-label">Confier une recherche</span>
            <svg class="choice-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>

          <button class="choice choice-track" type="button" data-flow="suivi" aria-pressed="false">
            <span class="choice-icon">
              <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
              </svg>
            </span>
            <span class="choice-label">Suivre ma demande</span>
            <svg class="choice-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>

        <section class="flow-panel" id="flowPanel" aria-live="polite" hidden>
          <h3 id="flowTitle">Votre projet</h3>
          <p class="flow-intro" id="flowIntro">Renseignez les éléments utiles à votre projet.</p>

          <div class="service-state" role="status">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 17h.01"/>
            </svg>
            <p id="serviceStateText"><strong>Envoi temporairement indisponible.</strong> La route publique d’enregistrement n’est pas opérationnelle. Aucune donnée saisie ici n’est transmise.</p>
          </div>

          <form class="part-form" id="requestForm" action="" method="post" novalidate>
            <input id="projectType" type="hidden" name="type_projet" value="">
            <div class="field-grid">
              <div class="field">
                <label for="firstName">Prénom</label>
                <input id="firstName" name="prenom" type="text" autocomplete="given-name" placeholder="Votre prénom">
              </div>
              <div class="field">
                <label for="lastName">Nom</label>
                <input id="lastName" name="nom" type="text" autocomplete="family-name" placeholder="Votre nom">
              </div>
              <div class="field">
                <label for="email">E-mail</label>
                <input id="email" name="email" type="email" autocomplete="email" placeholder="votre@email.fr">
              </div>
              <div class="field">
                <label for="phone">Téléphone</label>
                <input id="phone" name="telephone" type="tel" autocomplete="tel" placeholder="06 XX XX XX XX">
              </div>
              <div class="field field-wide">
                <label for="area">Secteur géographique</label>
                <input id="area" name="secteur" type="text" autocomplete="address-level2" placeholder="Ex. Bordeaux, Mérignac, 33…">
              </div>
              <div class="field field-wide" data-field="search">
                <label for="budget">Budget maximum</label>
                <input id="budget" name="budget_max" type="number" min="0" inputmode="numeric" placeholder="Ex. 350000 €">
              </div>
              <div class="field field-wide" data-field="property">
                <label for="amount" id="amountLabel">Prix souhaité</label>
                <input id="amount" name="montant" type="number" min="0" inputmode="numeric" placeholder="Ex. 280000 €">
              </div>
              <div class="field field-wide">
                <label for="details">Précisions utiles</label>
                <textarea id="details" name="informations" placeholder="Décrivez votre projet, vos contraintes et votre délai…"></textarea>
              </div>
            </div>
            <button class="disabled-action" type="submit" disabled aria-disabled="true">Envoi temporairement indisponible</button>
            <p class="local-note">Saisie locale uniquement : aucune information n’est envoyée ni enregistrée.</p>
          </form>

          <form class="part-form" id="trackingForm" action="" method="get" novalidate hidden>
            <div class="field">
              <label for="trackingCode">Votre code de suivi</label>
              <input id="trackingCode" name="code" type="text" inputmode="text" autocapitalize="characters" autocomplete="off" placeholder="Ex. LI-A3K9">
            </div>
            <button class="disabled-action" type="submit" disabled aria-disabled="true">Suivi temporairement indisponible</button>
            <p class="local-note">Aucune recherche n’est lancée : la route publique de suivi n’est pas disponible.</p>
          </form>
        </section>
      </div>
    </section>
  </main>

  <script>
    (() => {
      "use strict";

      const presentationScreen = document.getElementById("presentationScreen");
      const spaceScreen = document.getElementById("spaceScreen");
      const enterSpace = document.getElementById("enterSpace");
      const backToPresentation = document.getElementById("backToPresentation");
      const spaceTitle = document.getElementById("spaceTitle");
      const flowPanel = document.getElementById("flowPanel");
      const flowTitle = document.getElementById("flowTitle");
      const flowIntro = document.getElementById("flowIntro");
      const serviceStateText = document.getElementById("serviceStateText");
      const requestForm = document.getElementById("requestForm");
      const trackingForm = document.getElementById("trackingForm");
      const projectType = document.getElementById("projectType");
      const amountLabel = document.getElementById("amountLabel");
      const searchField = document.querySelector('[data-field="search"]');
      const propertyField = document.querySelector('[data-field="property"]');
      const choices = [...document.querySelectorAll("[data-flow]")];

      const flows = {
        recherche_achat: {
          title: "Je souhaite acheter",
          intro: "Décrivez le bien que vous recherchez et le secteur souhaité.",
          field: "search"
        },
        vendre: {
          title: "Je souhaite vendre",
          intro: "Présentez le bien que vous souhaitez confier à La Maison d’AVA.",
          field: "property",
          amount: "Prix souhaité"
        },
        confier_location: {
          title: "Confier mon bien à la location",
          intro: "Présentez le bien que vous souhaitez mettre en location.",
          field: "property",
          amount: "Loyer mensuel souhaité"
        },
        confier_recherche: {
          title: "Confier une recherche",
          intro: "Décrivez votre recherche afin qu’elle puisse être qualifiée par La Maison d’AVA.",
          field: "search"
        },
        suivi: {
          title: "Suivre ma demande",
          intro: "Munissez-vous du code remis lors de l’enregistrement de votre demande.",
          field: "tracking"
        }
      };

      function showSpace() {
        presentationScreen.hidden = true;
        spaceScreen.hidden = false;
        window.scrollTo({ top: 0, behavior: "auto" });
        spaceTitle.focus({ preventScroll: true });
      }

      function showPresentation() {
        spaceScreen.hidden = true;
        presentationScreen.hidden = false;
        flowPanel.hidden = true;
        choices.forEach((choice) => choice.setAttribute("aria-pressed", "false"));
        window.scrollTo({ top: 0, behavior: "auto" });
        enterSpace.focus({ preventScroll: true });
      }

      function selectFlow(flowName) {
        const flow = flows[flowName];
        if (!flow) return;

        choices.forEach((choice) => {
          choice.setAttribute("aria-pressed", String(choice.dataset.flow === flowName));
        });

        flowTitle.textContent = flow.title;
        flowIntro.textContent = flow.intro;
        projectType.value = flowName;
        flowPanel.hidden = false;

        const isTracking = flow.field === "tracking";
        requestForm.hidden = isTracking;
        trackingForm.hidden = !isTracking;
        searchField.hidden = flow.field !== "search";
        propertyField.hidden = flow.field !== "property";

        if (flow.amount) amountLabel.textContent = flow.amount;

        serviceStateText.innerHTML = isTracking
          ? "<strong>Suivi temporairement indisponible.</strong> La route publique de consultation n’est pas opérationnelle. Aucune recherche n’est effectuée."
          : "<strong>Envoi temporairement indisponible.</strong> La route publique d’enregistrement n’est pas opérationnelle. Aucune donnée saisie ici n’est transmise.";

        if (window.matchMedia("(max-width: 899px)").matches) {
          flowPanel.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }

      enterSpace.addEventListener("click", showSpace);
      backToPresentation.addEventListener("click", showPresentation);
      choices.forEach((choice) => {
        choice.addEventListener("click", () => selectFlow(choice.dataset.flow));
      });

      requestForm.addEventListener("submit", (event) => event.preventDefault());
      trackingForm.addEventListener("submit", (event) => event.preventDefault());

      document.querySelectorAll("[data-logo]").forEach((logo) => {
        logo.addEventListener("error", () => {
          logo.hidden = true;
          const fallback = logo.parentElement.querySelector("[data-logo-fallback]");
          if (fallback) fallback.hidden = false;
        }, { once: true });
      });
    })();
  </script>
</body>
</html>
