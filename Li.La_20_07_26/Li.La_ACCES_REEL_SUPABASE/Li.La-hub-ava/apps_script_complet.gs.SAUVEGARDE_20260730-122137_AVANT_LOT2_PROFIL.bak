// ============================================================================
// BOOTSTRAP — crée tous les onglets
// ============================================================================
function bootstrapAll() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  Logger.log('🚀 Bootstrap démarré');

  createOrUpdateMembres(ss);
  createIfMissing(ss, 'Evenements', ['id','titre','type','date','heure','duree','lieu','departement','description','max','actif','tally_url','date_creation','date_maj']);
  createIfMissing(ss, 'Masterclass', ['id','titre','thematique','date','heure','duree','format','description','max','actif','tally_url','date_creation','date_maj']);
  createIfMissing(ss, 'Inscriptions', ['id','type','event_id','membre_id','nom_invite','email_invite','tel_invite','source','date_inscription','confirmee']);
  createOrUpdateLiens(ss);
  createOrUpdateDepartements(ss);
  createOrUpdateConfig(ss);
  createOrUpdateAdmins(ss);
  createIfMissing(ss, 'Biens_a_vendre', ['id','titre','type_bien','prix','surface','pieces','ville','departement','description','membre_id','photo_url','date_ajout','actif','url_externe','exclusivite']);
  createIfMissing(ss, 'Demandes_recherche', ['id','titre','type_recherche','budget_max','surface_min','pieces_min','ville','departement','description','membre_id','date_ajout','actif','urgence','financement']);

  ['Feuille 1','Sheet1','Feuille1'].forEach(name => {
    const s = ss.getSheetByName(name);
    if (s && s.getLastRow() <= 1) { ss.deleteSheet(s); Logger.log('🗑️ ' + name + ' supprimé'); }
  });

  reorderTabs(ss);
  Logger.log('✅ Bootstrap terminé');
  SpreadsheetApp.getActiveSpreadsheet().toast('Bootstrap terminé — onglets créés/synchronisés', '✅ Hub AVA', 10);
}

function resyncMembres() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  createOrUpdateMembres(ss);
  SpreadsheetApp.getActiveSpreadsheet().toast('Membres re-synchronisés', '🔄 Synchro', 5);
}

// ============================================================================
// ONGLETS — création
// ============================================================================
function createOrUpdateMembres(ss) {
  let sheet = ss.getSheetByName('Membres');

  const requiredHeaders = [
    'id','prenom','nom','metier','departement','tel','email','auth_email',
    'site','linkedin','instagram','facebook','tiktok','photo','logo','bio',
    'carte_url','qr_url','verifie','actif','date_creation','date_maj'
  ];

  // Création initiale uniquement si l'onglet n'existe pas.
  if (!sheet) {
    sheet = ss.insertSheet('Membres');
    sheet.getRange(1, 1, 1, requiredHeaders.length).setValues([requiredHeaders]);
    sheet.setFrozenRows(1);
    Logger.log('➕ Membres créé');
  } else {
    // IMPORTANT : on ne vide jamais l'onglet existant.
    // On ajoute seulement les colonnes manquantes, afin de préserver
    // les membres ajoutés manuellement et leurs auth_email.
    const lastColumn = Math.max(sheet.getLastColumn(), 1);
    const existingHeaders = sheet
      .getRange(1, 1, 1, lastColumn)
      .getValues()[0]
      .map(h => String(h || '').trim());

    requiredHeaders.forEach(header => {
      if (!existingHeaders.includes(header)) {
        const newColumn = sheet.getLastColumn() + 1;
        sheet.getRange(1, newColumn).setValue(header);
        existingHeaders.push(header);
        Logger.log('➕ Colonne Membres ajoutée : ' + header);
      }
    });
  }

  const headers = sheet
    .getRange(1, 1, 1, sheet.getLastColumn())
    .getValues()[0]
    .map(h => String(h || '').trim());

  const idIndex = headers.indexOf('id');
  if (idIndex === -1) throw new Error('Colonne id introuvable dans Membres.');

  const existingIds = new Set();
  if (sheet.getLastRow() >= 2) {
    sheet
      .getRange(2, idIndex + 1, sheet.getLastRow() - 1, 1)
      .getValues()
      .flat()
      .forEach(id => {
        const normalized = String(id || '').trim();
        if (normalized) existingIds.add(normalized);
      });
  }

  const formData = readFormResponses(ss);
  const today = new Date().toISOString().split('T')[0];
  let addedCount = 0;

  // Les membres historiques absents sont ajoutés, mais aucune ligne existante
  // n'est écrasée et aucun nouveau membre n'est supprimé.
  MEMBRES_BASE.forEach(m => {
    if (existingIds.has(m.id)) return;

    const match = matchInForm(formData, m);
    const rowObject = {
      id: m.id,
      prenom: m.prenom,
      nom: m.nom,
      metier: m.metier,
      departement: m.departement,
      tel: match ? match.tel : '',
      email: match ? match.email : '',
      auth_email: '',
      site: match ? match.site : '',
      linkedin: match ? match.linkedin : '',
      instagram: match ? match.instagram : '',
      facebook: match ? match.facebook : '',
      tiktok: match ? match.tiktok : '',
      photo: match ? match.photo : '',
      logo: match ? match.logo : '',
      bio: '',
      carte_url: 'https://maison-ava.github.io/cartes/' + m.id,
      qr_url: 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://maison-ava.github.io/cartes/' + m.id,
      verifie: !!match,
      actif: true,
      date_creation: match ? match.horodateur : today,
      date_maj: match ? today : ''
    };

    writeObjectToRow(sheet, sheet.getLastRow() + 1, rowObject);
    existingIds.add(m.id);
    addedCount++;
  });

  formatHeaderRow(sheet, sheet.getLastColumn());
  sheet.autoResizeColumns(1, sheet.getLastColumn());
  Logger.log('✅ Membres préservés ; membres historiques ajoutés : ' + addedCount);
}

function createIfMissing(ss, name, headers) {
  if (ss.getSheetByName(name)) { Logger.log('= ' + name + ' existe'); return; }
  const sheet = ss.insertSheet(name);
  sheet.getRange(1,1,1,headers.length).setValues([headers]);
  sheet.setFrozenRows(1);
  formatHeaderRow(sheet, headers.length);
  sheet.autoResizeColumns(1, headers.length);
  Logger.log('➕ ' + name + ' créé');
}

