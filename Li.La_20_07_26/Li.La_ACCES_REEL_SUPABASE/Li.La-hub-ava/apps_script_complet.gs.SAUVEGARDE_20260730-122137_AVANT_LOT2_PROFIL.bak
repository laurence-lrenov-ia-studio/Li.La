    photo_url: secureFirstValue_(row, ['photo_url','image_url','photo','image','thumbnail']),
    photos: row.photos,
    panorama_url: secureFirstValue_(row, ['panorama_url','panorama','visite_virtuelle','virtual_tour_url']),
    date_ajout: row.date_ajout,
    actif: isSheetTrue(row.actif),
    url_externe: secureFirstValue_(row, ['url_externe','lien','url','annonce_url','external_url']),
