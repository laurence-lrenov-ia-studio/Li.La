// ============================================================================
// FORM_RESPONSES — lecture et matching
// ============================================================================
function readFormResponses(ss) {
  const noms = ['Form_Responses','Réponses au formulaire 1','Form Responses 1'];
  let sheet = null;
  for (const nom of noms) { sheet = ss.getSheetByName(nom); if (sheet) break; }
  if (!sheet || sheet.getLastRow() < 2) return [];

  const values = sheet.getRange(1,1,sheet.getLastRow(),sheet.getLastColumn()).getValues();
  const normalize = s => String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]/g,'');
  const headers = values[0].map(h => normalize(h));
  const colIdx = {};
  headers.forEach((h,i) => {
    if (h.includes('horodateur')||h.includes('timestamp')) colIdx.horodateur=i;
    else if (h.includes('prenom')&&colIdx.prenom===undefined) colIdx.prenom=i;
    else if (h.includes('nom')&&!h.includes('prenom')&&colIdx.nom===undefined) colIdx.nom=i;
    else if ((h.includes('telephone')||h==='tel'||h.includes('phone'))&&colIdx.tel===undefined) colIdx.tel=i;
    else if ((h.includes('email')||h.includes('mail'))&&colIdx.email===undefined) colIdx.email=i;
    else if (h.includes('site')&&colIdx.site===undefined) colIdx.site=i;
    else if (h.includes('linkedin')&&colIdx.linkedin===undefined) colIdx.linkedin=i;
    else if (h.includes('instagram')&&colIdx.instagram===undefined) colIdx.instagram=i;
    else if (h.includes('facebook')&&colIdx.facebook===undefined) colIdx.facebook=i;
    else if (h.includes('tiktok')&&colIdx.tiktok===undefined) colIdx.tiktok=i;
    else if (h.includes('photo')&&colIdx.photo===undefined) colIdx.photo=i;
  });

  const result = [];
  for (let r = 1; r < values.length; r++) {
    const row = values[r];
    if (!row[colIdx.nom]&&!row[colIdx.prenom]) continue;
    result.push({
      horodateur: row[colIdx.horodateur]||'',
      nom: String(row[colIdx.nom]||'').trim(),
      prenom: String(row[colIdx.prenom]||'').trim(),
      tel: String(row[colIdx.tel]||'').trim(),
      email: String(row[colIdx.email]||'').trim(),
      site: String(row[colIdx.site]||'').trim(),
      linkedin: String(row[colIdx.linkedin]||'').trim(),
      instagram: String(row[colIdx.instagram]||'').trim(),
      facebook: String(row[colIdx.facebook]||'').trim(),
      tiktok: String(row[colIdx.tiktok]||'').trim(),
      photo: convertDriveUrl(row[colIdx.photo]||''),
    });
  }
  return result;
}

function matchInForm(formData, membre) {
  const n = s => String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z]/g,'').trim();
  return formData.find(f => n(f.nom)===n(membre.nom) && n(f.prenom)===n(membre.prenom)) || null;
}

function convertDriveUrl(s) {
  const url = String(s||'').trim();
  if (!url) return '';
  const m1 = url.match(/drive\.google\.com\/open\?id=([a-zA-Z0-9_-]+)/);
  if (m1) return 'https://drive.google.com/uc?id='+m1[1]+'&export=view';
  const m2 = url.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
  if (m2) return 'https://drive.google.com/uc?id='+m2[1]+'&export=view';
  return url;
}

// ============================================================================
// HELPERS
// ============================================================================
function formatHeaderRow(sheet, cols) {
  sheet.getRange(1,1,1,cols).setBackground('#294C60').setFontColor('white').setFontWeight('bold').setHorizontalAlignment('center');
  sheet.setRowHeight(1,32);
}

function reorderTabs(ss) {
  const ordre = ['Form_Responses','Réponses au formulaire 1','Membres','Evenements','Masterclass','Inscriptions','Biens_a_vendre','Demandes_recherche','Liens','Departements','Config','Admins'];
  let pos = 1;
  for (const nom of ordre) {
    const sheet = ss.getSheetByName(nom);
    if (sheet) { ss.setActiveSheet(sheet); ss.moveActiveSheet(pos); pos++; }
  }
  ss.setActiveSheet(ss.getSheets()[0]);
}

// Helper : trouver la ligne d'un id (colonne A = id)
function findRowById(sheet, id) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return -1;
  const ids = sheet.getRange(2,1,lastRow-1,1).getValues().flat();
  for (let i = 0; i < ids.length; i++) {
    if (String(ids[i]).trim() === String(id).trim()) return i + 2;
  }
  return -1;
}

function getNextId(sheetName, prefix, padding) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() < 2) return prefix + String(1).padStart(padding,'0');
  const ids = sheet.getRange(2,1,sheet.getLastRow()-1,1).getValues().flat();
  let maxNum = 0;
  ids.forEach(id => { const m = String(id).match(new RegExp('^'+prefix+'(\\d+)$')); if (m) maxNum = Math.max(maxNum, parseInt(m[1])); });
  return prefix + String(maxNum+1).padStart(padding,'0');
}

function writeObjectToRow(sheet, rowNum, obj) {
  const lastCol = sheet.getLastColumn();
  const headers = sheet.getRange(1,1,1,lastCol).getValues()[0].map(h => String(h).trim());
  const rowValues = headers.map(h => obj[h] !== undefined ? obj[h] : '');
  sheet.getRange(rowNum,1,1,lastCol).setValues([rowValues]);
}

// Met à jour partiellement une ligne : lit l'existant, applique le patch, réécrit
function updateRowById(sheet, id, patch) {
  const rowNum = findRowById(sheet, id);
  if (rowNum === -1) throw new Error('Ligne introuvable: ' + id);
  const lastCol = sheet.getLastColumn();
  const headers = sheet.getRange(1,1,1,lastCol).getValues()[0].map(h => String(h).trim());
  const current = sheet.getRange(rowNum,1,1,lastCol).getValues()[0];
  const merged = headers.map((h,i) => patch[h] !== undefined ? patch[h] : current[i]);
  sheet.getRange(rowNum,1,1,lastCol).setValues([merged]);
}

// ============================================================================
// API — doGet
// ============================================================================
function doGet(e) {
  try {
    const action = String(e && e.parameter ? (e.parameter.action || '') : '').trim().toLowerCase();
    if (action === 'getpublicsummary') return jsonResponse(getPublicSummary());
    if (action === 'ping') return jsonResponse({ ok:true });
    return jsonResponse({ ok:false, error:'AUTH_REQUIRED' });
  } catch(err) {
    return jsonResponse({ ok:false, error:'AUTH_REQUIRED' });
  }
}

// ============================================================================
// API — doPost (version unique, complète)
// ============================================================================
function doPost(e) {
  let payload;
  try {
    payload = parseSecurePreviewRequest_(e);
  } catch (err) {
    return jsonResponse({ ok:false, error:'SECURITY_MAINTENANCE' });
  }

  if (!payload || payload.action !== 'getSecurePreview') {
    return jsonResponse({ ok:false, error:'SECURITY_MAINTENANCE' });
  }

  return jsonResponse(getSecurePreview_(payload));
}

function parseSecurePreviewRequest_(e) {
  const contents = e && e.postData ? String(e.postData.contents || '') : '';
  if (!contents || contents.length > 20000) throw new Error('INVALID_REQUEST');
  const payload = JSON.parse(contents);
  if (!payload || Array.isArray(payload) || typeof payload !== 'object') {
    throw new Error('INVALID_REQUEST');
  }
  return payload;
}

function getSecurePreview_(payload) {
  try {
    const properties = PropertiesService.getScriptProperties();
    if (!isSheetTrue(properties.getProperty('HUB_SECURE_PREVIEW_ENABLED'))) {
      return { ok:false, error:'CONFIG_ENABLED_MISSING' };
    }

    if (!verifySecureGatewaySecret_(payload.gateway_secret, properties)) {
      return { ok:false, error:'GATEWAY_SECRET_INVALID' };
    }

    const accessToken = String(payload.access_token || '').trim();
    if (!isSecureAccessTokenFormat_(accessToken)) {
      return { ok:false, error:'AUTH_REQUIRED' };
    }

    const authResult = verifySupabaseAccessToken_(accessToken, properties);
    if (!authResult.ok) return authResult;

    const memberResult = findUniqueActiveMemberByAuthEmail_(authResult.email);
    if (!memberResult.ok) return memberResult;

    return buildSecurePreview_(memberResult);
  } catch (err) {
    console.error('getSecurePreview indisponible');
    return { ok:false, error:'INTERNAL_ERROR' };
  }
}

function verifySecureGatewaySecret_(providedSecret, properties) {
  const expectedSecret = String(properties.getProperty('HUB_GATEWAY_SHARED_SECRET') || '');
  const receivedSecret = String(providedSecret || '');
  if (expectedSecret.length < 32 || receivedSecret.length < 32) return false;
  return secureStringEquals_(expectedSecret, receivedSecret);
}

function secureStringEquals_(left, right) {
  const leftDigest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    String(left),
    Utilities.Charset.UTF_8
  );
  const rightDigest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    String(right),
    Utilities.Charset.UTF_8
  );
  let difference = leftDigest.length ^ rightDigest.length;
  const length = Math.max(leftDigest.length, rightDigest.length);
  for (let i = 0; i < length; i++) {
    difference |= (leftDigest[i] || 0) ^ (rightDigest[i] || 0);
  }
  return difference === 0;
}

function isSecureAccessTokenFormat_(accessToken) {
  return accessToken.length >= 32 &&
    accessToken.length <= 8185 &&
    /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(accessToken);
}

function verifySupabaseAccessToken_(accessToken, properties) {
  const supabaseUrl = String(properties.getProperty('SUPABASE_URL') || '').trim().replace(/\/+$/, '');
  const supabaseAnonKey = String(properties.getProperty('SUPABASE_ANON_KEY') || '').trim();
  if (!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(supabaseUrl) || !supabaseAnonKey) {
    return { ok:false, error:'SUPABASE_CONFIG_INVALID' };
  }

  let response;
  try {
    response = UrlFetchApp.fetch(supabaseUrl + '/auth/v1/user', {
      method: 'get',
      headers: {
        apikey: supabaseAnonKey,
        Authorization: 'Bearer ' + accessToken
      },
      followRedirects: false,
      muteHttpExceptions: true
    });
  } catch (err) {
    return { ok:false, error:'SUPABASE_UNREACHABLE' };
  }

  const status = response.getResponseCode();
  if (status === 401 || status === 403) {
    return { ok:false, error:'AUTH_REQUIRED' };
  }
  if (status !== 200) {
    return { ok:false, error:'SUPABASE_RESPONSE_INVALID' };
  }

  let user;
  try {
    user = JSON.parse(response.getContentText());
  } catch (err) {
    return { ok:false, error:'SUPABASE_RESPONSE_INVALID' };
  }

  const email = normalizeAuthEmail_(user && user.email);
  if (!email) return { ok:false, error:'AUTH_REQUIRED' };
  return { ok:true, email };
}

function normalizeAuthEmail_(email) {
  return String(email || '').trim().toLowerCase();
}

function findUniqueActiveMemberByAuthEmail_(authenticatedEmail) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Membres');
  if (!sheet || sheet.getLastRow() < 2 || sheet.getLastColumn() < 1) {
    return { ok:false, error:'MEMBERS_SHEET_MISSING' };
  }

  const values = sheet.getDataRange().getValues();
  const headers = values[0].map(header => String(header || '').trim().toLowerCase());
  const emailIndex = findUniqueSecureHeaderIndex_(headers, 'auth_email');
  const idIndex = findUniqueSecureHeaderIndex_(headers, 'id');
  const activeIndex = findUniqueSecureHeaderIndex_(headers, 'actif');
  if (emailIndex < 0 || idIndex < 0 || activeIndex < 0) {
    return { ok:false, error:'MEMBERS_HEADERS_INVALID' };
  }

  const matches = [];
  for (let rowIndex = 1; rowIndex < values.length; rowIndex++) {
    if (normalizeAuthEmail_(values[rowIndex][emailIndex]) === authenticatedEmail) {
      matches.push(values[rowIndex]);
    }
  }

  if (matches.length === 0) return { ok:false, error:'HUB_ACCESS_DENIED' };
  if (matches.length !== 1) return { ok:false, error:'INTERNAL_ERROR' };

  const memberRow = matches[0];
  if (!isSheetTrue(memberRow[activeIndex])) {
    return { ok:false, error:'HUB_ACCESS_DENIED' };
  }

  const memberId = String(memberRow[idIndex] || '').trim();
  if (!memberId) return { ok:false, error:'INTERNAL_ERROR' };

  const member = {};
  headers.forEach((header, index) => {
    if (header && member[header] === undefined) member[header] = memberRow[index];
  });

  return {
    ok:true,
    memberId,
    member: projectSecureMember_(member)
  };
}

function findUniqueSecureHeaderIndex_(headers, expectedHeader) {
  const matches = [];
  headers.forEach((header, index) => {
    if (header === expectedHeader) matches.push(index);
  });
  return matches.length === 1 ? matches[0] : -1;
}

function deriveSecureMemberAccess_(memberId) {
  const admin = getAdminForMemberCode(memberId);
  return {
    membre_id: memberId,
    isAdmin: !!admin,
    role: admin ? String(admin.role || '') : 'member',
    scope: admin ? String(admin.scope || 'all') : 'self',
    readOnly: true
  };
}

function buildSecurePreview_(memberResult) {
  return {
    ok:true,
    member: memberResult.member,
    access: deriveSecureMemberAccess_(memberResult.memberId),
    membres: readSecureActiveRows_('Membres').map(projectSecureMember_),
    evenements: readSecureActiveRows_('Evenements').map(projectSecureEvent_),
    masterclass: readSecureActiveRows_('Masterclass').map(projectSecureMasterclass_),
    liens: readSecureActiveRows_('Liens').map(projectSecureLink_),
    departements: readSecureActiveRows_('Departements').map(projectSecureDepartment_),
    biens: readSecureActiveRows_('Biens_a_vendre').map(projectSecureProperty_),
    demandes: readSecureActiveRows_('Demandes_recherche').map(projectSecureSearch_),
    config: readSecurePublicConfig_(),
    generatedAt: new Date().toISOString()
  };
}

function readSecurePublicConfig_() {
  const allowedKeys = new Set([
    'tally_masterclass',
    'tally_events_33',
    'tally_events_75',
    'tally_events_92',
    'tally_events_94'
  ]);

  return readSheetAsObjects('Config')
    .filter(row => allowedKeys.has(String(row.cle || '').trim()))
    .map(row => ({
      cle: row.cle,
      valeur: row.valeur
    }));
}

function readSecureActiveRows_(sheetName) {
  return readSheetAsObjects(sheetName).filter(row => isSheetTrue(row.actif));
}

function secureFirstValue_(row, allowedSourceFields) {
  for (let i = 0; i < allowedSourceFields.length; i++) {
    const value = row[allowedSourceFields[i]];
    if (value !== null && value !== undefined && value !== '') return value;
  }
  return '';
}

function projectSecureMember_(row) {
  return {
    id: row.id,
    prenom: row.prenom,
    nom: row.nom,
    metier: row.metier,
    departement: row.departement,
    tel: row.tel,
    email: row.email,
    site: row.site,
    linkedin: row.linkedin,
    instagram: row.instagram,
    facebook: row.facebook,
    tiktok: row.tiktok,
    photo: row.photo,
    bio: row.bio,
    carte_url: row.carte_url,
    qr_url: row.qr_url,
    verifie: isSheetTrue(row.verifie)
  };
}

function projectSecureEvent_(row) {
