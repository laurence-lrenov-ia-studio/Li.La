  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Membres');
  const row = findRowById(sheet, id);
  if (row===-1) throw new Error('Membre introuvable');
  sheet.deleteRow(row);
  return { ok:true, message:'Membre supprimé' };
}

